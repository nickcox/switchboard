{
  "name": "switchboard-durable-orchestration-investigation",
  "private": true,
  "type": "module",
  "engines": {
    "node": "26.7.0"
  },
  "scripts": {
    "check": "node ../../node_modules/typescript/bin/tsc --project tsconfig.json",
    "test": "node --test --test-timeout=30000 smoke.test.ts \"scenario/*.test.ts\" \"design-a/*.test.ts\" \"design-b/*.test.ts\" \"failures/*.test.ts\" \"real/*.test.ts\"",
    "test:real": "node --test --test-timeout=30000 \"real/*.test.ts\"", 
    "test:failures": "node --test --test-timeout=30000 \"failures/*.test.ts\""
  },
  "dependencies": {
    "@earendil-works/chord": "1.4.0",
    "@earendil-works/pi-ai": "1.4.0",
    "@earendil-works/pi-durable": "1.4.0",
    "durable-1-3": "npm:@earendil-works/pi-durable@1.3.0",
    "pi-ai-1-3": "npm:@earendil-works/pi-ai@1.3.0"
  }
}
